# Animal Crossing Vita - Unified Build Environment
FROM --platform=linux/amd64 vitasdk/vitasdk:latest

LABEL description="Animal Crossing Vita unified build environment"
LABEL version="2.0.0"

# Install all required packages for AC-Decomp integration and asset processing
RUN apk update && apk add --no-cache \
    git curl wget build-base cmake pkgconfig bzip2 \
    openssl bash zip unzip file ninja \
    python3 py3-pip py3-pillow py3-numpy \
    && rm -rf /var/cache/apk/*

# Build VitaGL with proven stable configuration (sm64-vita)
RUN echo "Building VitaGL with proven stable configuration..." \
    && git clone https://github.com/Rinnegatamante/vitaGL.git /tmp/vitaGL \
    && cd /tmp/vitaGL \
    && git reset --hard 9c963ab \
    && echo "VitaGL commit: $(git rev-parse HEAD)" \
    && make HAVE_SBRK=1 HAVE_SHARK=1 install -j4 \
    && rm -rf /tmp/vitaGL

# Build supporting libraries
RUN echo "Building VitaGL supporting libraries..." \
    && git clone https://github.com/bythos14/SceShaccCgExt.git /tmp/SceShaccCgExt \
    && cd /tmp/SceShaccCgExt \
    && mkdir build && cd build \
    && cmake .. -DCMAKE_BUILD_TYPE=Release \
    && make -j4 && make install \
    && rm -rf /tmp/SceShaccCgExt

RUN git clone https://github.com/Rinnegatamante/vitaShaRK.git /tmp/vitaShaRK \
    && cd /tmp/vitaShaRK \
    && make install -j4 \
    && rm -rf /tmp/vitaShaRK

# Set up workspace
WORKDIR /workspace
COPY . /workspace/

# Create build info
RUN echo "Animal Crossing Vita - Unified Build Environment v2.0.0" > /workspace/build_info.txt \
    && echo "Python: $(python3 --version)" >> /workspace/build_info.txt \
    && echo "VitaGL: commit 9c963ab with HAVE_SBRK=1 HAVE_SHARK=1" >> /workspace/build_info.txt \
    && echo "Ninja: $(ninja --version)" >> /workspace/build_info.txt \
    && echo "Built: $(date)" >> /workspace/build_info.txt

# Set up build environment variables
ENV AC_VITA_BUILD=1
ENV TARGET_VITA=1  
ENV CMAKE_TOOLCHAIN_FILE="$VITASDK/share/vita.toolchain.cmake"
ENV PYTHONPATH="/workspace/tools:$PYTHONPATH"

# Create necessary directories
RUN mkdir -p vita/build vita/sce_sys vita/sce_sys/livearea/contents

CMD ["bash"] 